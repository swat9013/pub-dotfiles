#!/bin/sh
# ~/.gemini/config/skills.json の inherits に Claude Code の skill 置き場を足す。
# chezmoi が現在の内容を stdin で渡し、stdout を新内容として書く。
#
# Antigravity は ~/.claude/skills も Claude Code plugin の skill も既定では読まない。
# sync-claude-plugin-skills が有効な plugin のディレクトリと ~/.claude/skills を並べた
# ~/.local/share/claude-plugin-skills/skills.json を生成するので、それを inherits に登録する。
# path は ~/.gemini/config からの相対 path で書く (Antigravity の inherits は ~/ を展開しない)。
# 既存の inherits / entries はそのまま残し、足りない entry だけを追記する。
set -eu

current=$(cat)
inherits='[{"path": "../../.local/share/claude-plugin-skills/skills.json"}]'

if [ -z "$current" ]; then
	current='{}'
fi

# jq 不在や壊れた JSON のときは現在の内容をそのまま返す (既存の設定を消さない)
if command -v jq >/dev/null 2>&1 &&
	merged=$(printf '%s' "$current" | jq --argjson add "$inherits" '
	  .inherits = ((.inherits // []) + ($add - (.inherits // [])))
	' 2>/dev/null); then
	printf '%s\n' "$merged"
else
	printf '%s\n' "$current"
fi
