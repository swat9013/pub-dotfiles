# Usage: brew bundle install --global && brew bundle cleanup --global
#
# package manager の正本 (ADR 0019)。3 環境 (mac / SSH remote / sandbox VM) が
# この manifest から導入する。mise は runtime version manager 専任
# (正本: dot_config/mise/config.toml。per-project で版を切り替える言語処理系のみ)。
# 新規 CLI の追加はここを既定とし、「per-project で版を切り替えたい」ものだけ
# mise の [tools] へ置く (判定基準は ADR 0019 §2)。
# mac でしか成立しないもの (cask / GUI / fonts / vscode 拡張 / mas / macOS 固有
# formula) は下の OS.mac? ブロックへ。

# Taps
# tap は trusted: true を必ず付ける (Homebrew 6.0+ が解釈)。third-party tap の
# formula/cask は trust 未登録だと読み込まれない。`brew bundle cleanup --force` は
# trust store を Brewfile の trusted: 宣言だけで置き換える (Trust.replace!) ため、
# 宣言が無いと毎回 trust が消える。install 側も宣言を entry 読み込み前に適用する
# ので、この Brewfile 単体で trust が完結する (ADR 0019 §3)。
tap "atlassian/acli", trusted: true  # acli (core に formula が無い)

# Bootstrap 層: 導入経路は環境ごと (mac = brew 直、Linux = bootstrap-remote.sh /
# sandbox-env kit) だが、更新はこの宣言で全環境が収束する
brew "chezmoi"
brew "mise"

# Cross-platform CLI (ADR 0019 で mise [tools] から移管)
brew "apm"
brew "atlassian/acli/acli"
brew "awscli"
brew "bat"
brew "difftastic"
brew "fd"
brew "fzf"
brew "gh"
brew "ghq"
brew "git-delta"
brew "gitleaks"
brew "glab"
brew "glow"
brew "gogcli"
brew "hadolint"
brew "herdr"
brew "jq"
brew "lazygit"
brew "mermaid-cli"
brew "pre-commit"
brew "ripgrep"
brew "sheldon"
brew "shellcheck"
brew "starship"
brew "uv"

# Editor: distro の emacs は版がホスト依存で、AL2023 の 28.2 は設定 (Emacs 29+ 前提)
# が成立しなかった (ADR 0019 §4)。brew の emacs は tree-sitter 有効 / native-comp 無効
# (libgccjit 非依存) — byte-compile へは run_onchange_byte-compile-emacs.sh.tmpl が
# native-comp-available-p gate で自動縮退する。
brew "emacs"

# Diagram: AL2023 の repo に plantuml が無く distro ではパリティが崩れていたため
# cross-platform 側へ (graphviz は依存として入る)
brew "plantuml"

# npm backend (core formula に Linux bottle が無い node 系 CLI を含む)。
# node は npm entry の実行基盤としてここで入れる。per-project の node 版は
# 従来どおり .mise.toml で pin できる (activate が brew node より前に解決する)
brew "node"
npm "@doist/todoist-cli"
npm "aws-cdk"
npm "markdownlint-cli2"
npm "opensrc"

if OS.mac?
  # Taps (macOS only)
  tap "docker/tap", trusted: true                  # Docker Sandboxes (sbx)
  tap "macos-fuse-t/homebrew-cask", trusted: true  # FUSE-T 公式 tap (sshfs-fuse-t 用)
  tap "songmu/tap", trusted: true
  tap "stablyai/orca", trusted: true               # Orca (cask "stablyai/orca/orca" の tap を明示管理)
  tap "swat9013/tap", trusted: true                # sbxr / claude-dispatcher (GoReleaser が生成する cask)

  # System 基盤 (mac のみ brew。Linux は distro パッケージの bootstrap 層 —
  # brew より前に必要なため。ADR 0019 §4)
  brew "bash"
  brew "zsh"
  brew "git"
  brew "curl"
  brew "wget"
  brew "coreutils"     # GNU userland
  brew "openjdk"       # mise core:java は JDK distribution の切替を伴うため見送り
  brew "ffmpeg"
  brew "imagemagick"
  brew "graphviz"
  brew "pkg-config"    # build 基盤
  brew "zlib"          # build 基盤
  brew "cmark-gfm"     # GFM → HTML (markdown-mode の M-x markdown-preview 用)
  brew "nkf"
  brew "ncdu"
  brew "tree"
  brew "pwgen"
  brew "git-crypt"
  brew "git-secrets"   # pre-commit で known-format secret を block (ADR 0010)
  brew "ollama"        # mac では brew services で常駐管理する

  # CLI tools (macOS only)
  brew "gsed"          # Linux already has GNU sed
  brew "mas"           # macOS App Store CLI
  brew "terminal-notifier"

  # Filesystem (macOS) — cask を brew より先に評価させるため CLI tools 群と分離
  cask "fuse-t"        # kext 不要な FUSE 実装 (sshfs-fuse-t が依存)
  brew "macos-fuse-t/homebrew-cask/sshfs-fuse-t"  # sshmount 用 (dot_zsh/sshfs.zsh)

  # Infrastructure (macOS only)
  brew "colima"        # Linux VM wrapper for Mac
  brew "docker"        # WSL2 uses Docker Desktop / docker-engine instead
  brew "docker-compose"
  cask "docker/tap/sbx"  # Docker Sandboxes — AI agent を microVM に隔離 (Apple Silicon + macOS 14+)
  cask "swat9013/tap/sbxr"               # repo 宣言から sbx の sandbox VM を作る (sbx 前提のため mac のみ)
  cask "swat9013/tap/claude-dispatcher"  # 着手可の issue を Claude Code に無人で実装させる (cask のため mac ブロック)

  brew "laminate"  # songmu/tap (text/code → image)

  # Other (macOS only)
  brew "handbrake"
  brew "postgresql"

  # GUI apps (macOS cask)
  cask "battery"
  cask "codex"
  cask "dbeaver-community"
  cask "ghostty"
  cask "hammerspoon"
  cask "obsidian"
  cask "stablyai/orca/orca"
  cask "via"
  cask "visual-studio-code"
  cask "xquartz"
  cask "zed"

  # Fonts (macOS cask) — config が font-family で名指ししているものだけを入れる
  cask "font-jetbrains-mono"  # dot_emacs.d/lisp/init-ui.el (GUI Emacs)
  cask "font-plemol-jp"       # dot_config/zed/settings.json, vscode/settings.json (PlemolJP35)

  # VS Code extensions (managed by macOS Code.app; WSL2 uses Remote-WSL)
  vscode "3w36zj6.textlint"
  vscode "anthropic.claude-code"
  vscode "bierner.markdown-mermaid"
  vscode "biomejs.biome"
  vscode "cweijan.vscode-office"
  vscode "davidanson.vscode-markdownlint"
  vscode "eamodio.gitlens"
  vscode "editorconfig.editorconfig"
  vscode "esbenp.prettier-vscode"
  vscode "gruntfuggly.todo-tree"
  vscode "hashicorp.terraform"
  vscode "hediet.vscode-drawio"
  vscode "mhutchie.git-graph"
  vscode "ms-ceintl.vscode-language-pack-ja"
  vscode "ms-python.python"
  vscode "ms-python.vscode-pylance"
  vscode "ms-toolsai.jupyter"
  vscode "ms-vscode-remote.remote-ssh"
  vscode "ms-vscode-remote.remote-ssh-edit"
  vscode "ms-vscode.remote-explorer"
  vscode "pkief.material-icon-theme"
  vscode "redhat.vscode-yaml"
  vscode "streetsidesoftware.code-spell-checker"
  vscode "tuttieee.emacs-mcx"
  vscode "vue.volar"
  vscode "yzhang.markdown-all-in-one"
end
