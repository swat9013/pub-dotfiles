{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "advisorModel": "fable",
  "agentPushNotifEnabled": true,
  "autoMemoryEnabled": false,
  "awaySummaryEnabled": false,
  "effortLevel": "medium",
  "enabledPlugins": {
    "claude-security@claude-plugins-official": false,
    "eli5@claude-community": false,
    "evolutionary-naming@kawasima-skills": false,
    "mattpocock-skills@claude-plugins-official": false,
    "modularity@vladikk-modularity": false,
    "swat-obsidian@swat-obsidian": true
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_ENABLE_TODO_TOOLS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "repo": "anthropics/claude-plugins-community",
        "source": "github"
      }
    },
    "kawasima-skills": {
      "source": {
        "repo": "kawasima/evolutionary-naming",
        "source": "github"
      }
    },
    "vladikk-modularity": {
      "source": {
        "repo": "vladikk/modularity",
        "source": "github"
      }
    }
  },
  "feedbackDrafts": "off",
  "inputNeededNotifEnabled": true,
  "language": "ja",
  "model": "opus",
  "outputStyle": "judgment-audit",
  "permissions": {
    "allow": [
      "AskUserQuestion",
