      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(scp:*)",
      "Bash(sh:*)",
      "Bash(ssh:*)",
      "Bash(sudo:*)",
      "Bash(wget:*)",
      "Bash(zsh:*)",
      "Edit(./**/*.crt)",
      "Edit(./**/*.key)",
      "Edit(./**/*.p12)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.pfx)",
      "Edit(./**/.env*)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/scripts/**)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/statusline.sh)",
      "Edit(~/.netrc)",
      "Edit(~/.ssh/**)",
      "NotebookEdit",
      "Read(./**/*.crt)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)",
      "Read(./**/.env*)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/glab/**)",
      "Read(~/.kube/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.ssh/**)"
    ]
  },
  "plansDirectory": ".ai/plans",
  "preferredNotifChannel": "iterm2",
  "promptSuggestionEnabled": false,
  "remoteControlAtStartup": false,
  "skillListingBudgetFraction": 0.02,
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "~/.claude/statusline.sh",
    "padding": 0,
    "type": "command"
  },
  "theme": "dark",
  "tui": "fullscreen",
  "verbose": true
}
