      "Edit(//private/tmp/**)",
      "Edit(//tmp/**)",
      "Glob",
      "Read(.claude/skills/**/*)",
      "Read(~/.claude/skills/**/*)",
      "Read(~/ghq/**)",
      "Skill",
      "WebSearch",
      "mcp__plugin_swat-obsidian_vault__*"
